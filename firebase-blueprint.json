{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store product details",
      "type": "object",
      "properties": {
        "product_id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category_id": { "type": "string" },
        "stock": { "type": "number" }
      },
      "required": ["product_id", "name", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "order_id": { "type": "string" },
        "customer_id": { "type": "string" },
        "total_amount": { "type": "number" },
        "status": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["order_id", "customer_id", "total_amount"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profile information",
      "type": "object",
      "properties": {
        "customer_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["customer_id", "name", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "Product" },
      "description": "Products collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "Order" },
      "description": "Orders collection"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "Customer" },
      "description": "Customers collection"
    }
  }
}
